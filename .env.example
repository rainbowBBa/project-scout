# 전체 항목 설명: docs/001_기술스택-조사-에이전트-설계/08-설정.md
# 전부 기본값이다. 바꿀 것만 남기고 지워도 된다.
# 우선순위: CLI 플래그 > .env > 코드 기본값

# ─────────────────────────────────────────────────────────────
# 앱(scout)
# ─────────────────────────────────────────────────────────────

# 필수
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 계정에 따라 형태가 다르다. 쓸 수 있는 값은 `scout doctor`가 찍어준다
#   anthropic.claude-sonnet-5 | us.anthropic.claude-sonnet-4-6 | arn:aws:bedrock:...
SCOUT_MODEL_ID=anthropic.claude-sonnet-5

# Bedrock 호출 (초, 횟수)
SCOUT_BEDROCK_READ_TIMEOUT_SECONDS=600      # 30 이상
SCOUT_BEDROCK_CONNECT_TIMEOUT_SECONDS=10    # 1 이상
SCOUT_BEDROCK_MAX_ATTEMPTS=3                # 1~10. 1이면 재시도 없음
SCOUT_MCP_READ_TIMEOUT_SECONDS=60           # 5 이상

# 규모 — CLI 플래그(--max-components, --max-candidates)가 덮는다
SCOUT_MAX_COMPONENTS=3                      # 1 이상
SCOUT_MAX_CANDIDATES=3                      # 1 이상
SCOUT_INTERVIEW_MAX_TURNS=5                 # 되묻기 상한. 개발 중엔 2

# 툴 루프 상한 — superstep 수다. 툴 호출 수는 대략 이 값의 절반이다
SCOUT_DESIGN_RECURSION_LIMIT=10
SCOUT_SEARCH_RECURSION_LIMIT=16

# 승인되는 웹검색 횟수 — design은 실행 전체, search는 결정 지점당
SCOUT_DESIGN_WEB_SEARCHES=3
SCOUT_SEARCH_WEB_SEARCHES=5
SCOUT_MAX_SEARCH_REJECTIONS=3               # 거부 몇 번에 차단할지. 1 이상

# 동시 호출 상한
SCOUT_LLM_CONCURRENCY=4
SCOUT_MCP_CONCURRENCY=8

# 판정·점수
SCOUT_MAX_REGROUND=1                        # grounding 위반 시 재판정 횟수. 0~3
SCOUT_MAX_WEB_FACTS=6                       # 후보당 dossier의 웹 사실 상한. 1 이상
SCOUT_TOOL_PAYLOAD_CHARS=1200               # 툴 응답을 자르는 길이. 200 이상
SCOUT_MIN_ALTERNATIVES=2                    # 결정 지점의 최소 보기 수. 2 이상
SCOUT_DECISIVE_GAP=2                        # 1·2위 점수차가 이만큼이면 decisive. 1~4

# 리포트 표시
SCOUT_REPORT_TITLE_CHARS=60                 # 넘으면 원문 설명으로 폴백. 40 이상
SCOUT_REPORT_SUMMARY_CHARS=90               # 접힌 블록의 요약 줄 길이. 30 이상
SCOUT_REPORT_RISKS=3                        # "가장 큰 위험" 개수. 1 이상

SCOUT_RUNS_DIR=runs

# 개발용 LLM 응답 캐시. 기본 off — 켜면 어제의 판정이 오늘의 추천으로 나온다.
# 토큰·타임아웃을 실측할 때는 끈다
# SCOUT_LLM_CACHE=1
# SCOUT_LLM_CACHE_PATH=runs/llm-cache.sqlite

# ─────────────────────────────────────────────────────────────
# MCP 서버(scout-net-mcp)
#
# 앱은 이 값을 쓰지 않고 자식 프로세스에 전달만 한다. 새 설정은
# SCOUT_NET_ 접두사를 써야 전달된다 (mcp_client.SERVER_ENV_KEYS)
# ─────────────────────────────────────────────────────────────

# 없으면 GitHub API가 60req/h로 제한된다
GITHUB_TOKEN=

# 여기 없는 도메인으로는 나가지 않는다
SCOUT_EGRESS_ALLOWLIST=registry.npmjs.org,api.npmjs.org,pypi.org,api.github.com,api.osv.dev,www.google.com

# HTTP 응답 디스크 캐시 (LLM 캐시와 다른 층이다)
SCOUT_CACHE_DIR=.cache/scout-net
SCOUT_CACHE_TTL_HOURS=24

SCOUT_RATE_LIMIT_RPS=5                      # 호스트별 토큰버킷. 버스트도 이 값
SCOUT_NET_HTTP_TIMEOUT_SECONDS=10.0         # provider의 인터넷 대기 상한. 0 초과
SCOUT_NET_NPM_SEARCH_SIZE=10                # npm 검색 결과 개수. 1~250

# 교체 지점 — 사내 검색 API가 생기면 이 값만 바꾼다
SCOUT_SEARCH_PROVIDER=ddg
