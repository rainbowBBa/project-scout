# 설정 항목의 정본 목록은 docs/001_기술스택-조사-에이전트-설계/08-설정.md 다.
# 여기 값은 전부 기본값이므로, 바꿀 것만 남기고 나머지는 지워도 된다.
# 우선순위: CLI 플래그 > 환경변수/.env > 코드 기본값
#
# 범위가 정해진 값에 범위 밖을 넣으면 **실행 시작 전에** 터진다 —
# `[FAIL] Settings 로딩 실패`로 이유가 함께 찍힌다. 조용히 무시되지 않는다.

# ─────────────────────────────────────────────────────────────
# 앱(scout) — MCP 서버에 넘기지 않는다
# ─────────────────────────────────────────────────────────────

# Bedrock 리전 (필수)
AWS_DEFAULT_REGION=us-east-1

# 인증 — Access Key 방식. boto3가 환경에서 직접 읽는다. Settings에는 들어가지 않는다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 모델 ID — 계정에 따라 형태가 다르다. scout doctor 가 찍어준다.
# 목록에 보이는 것과 호출 가능한 것이 다르다 — 온디맨드가 막힌 모델은
# 크로스리전 프로파일(us. 접두사)이 필요하다
#   anthropic.claude-sonnet-5 | us.anthropic.claude-sonnet-4-6 | arn:aws:bedrock:...
SCOUT_MODEL_ID=anthropic.claude-sonnet-5

# ── Bedrock 타임아웃·재시도 (초) ────────────────────────────
# AWS_ 로 시작하는 이름을 쓰지 않는다 — boto3의 기본 자격 체인이 읽는 표준 변수가
# 아니라 우리가 명시 전달하는 값이다 (08-설정.md 규칙 1)

# 읽기 상한. 기본 60초(botocore)에서 design 단계가 죽었다 — 툴 기록이 담긴
# 프롬프트로 구조화 출력을 만드는 데 부족했고 파이프라인 전체가 거기서 끝났다.
# 짧아서 죽는 것이 길어서 기다리는 것보다 나쁘다. 최소 30
SCOUT_BEDROCK_READ_TIMEOUT_SECONDS=600

# 연결 상한. 연결은 빠르거나 아예 안 된다 — 느리면 리전·자격 문제다. 최소 1
SCOUT_BEDROCK_CONNECT_TIMEOUT_SECONDS=10

# 재시도 횟수. verify가 병렬로 돌아 스로틀링에 부딪힌다. 1이면 재시도 없음. 1~10
SCOUT_BEDROCK_MAX_ATTEMPTS=3

# MCP stdio 세션의 응답 대기 상한. 서버가 인터넷을 때리는 유일한 출구이고
# search가 결정 지점을 병렬로 돌리므로, 없으면 그 요소가 멈춘 채 남는다. 최소 5
SCOUT_MCP_READ_TIMEOUT_SECONDS=60

# ── 규모 (CLI 플래그가 이 값을 덮는다) ──────────────────────
SCOUT_MAX_COMPONENTS=3
SCOUT_MAX_CANDIDATES=3

# interview 되묻기 상한 — LLM이 판단해 그 전에 끝낼 수도 있다. CLI 플래그 없음.
# 개발 중에는 2로 내린다
SCOUT_INTERVIEW_MAX_TURNS=5

# 툴 루프 상한 — LangGraph의 **superstep 수**지 툴 호출 수가 아니다.
# ReAct는 한 바퀴가 model + tools 두 스텝이라 10이면 툴 호출 4~5회쯤이다.
# 이걸 모르면 "10회로 줄였다"가 실제로는 5회가 된다
SCOUT_DESIGN_RECURSION_LIMIT=10
SCOUT_SEARCH_RECURSION_LIMIT=16

# 승인되는 웹검색 상한. design은 **실행 전체**, search는 **결정 지점당**이다 —
# 설계는 요소별로 펼치지 않고 한 번 돌기 때문이다.
# 이 값은 에이전트 프롬프트에도 주입된다 — 내리면 프롬프트가 함께 따라간다
SCOUT_DESIGN_WEB_SEARCHES=3
SCOUT_SEARCH_WEB_SEARCHES=5

# 거부 몇 번에 웹검색을 차단할지. 거부되면 원본 툴을 부르지 않는다는 보장(불변식 14)은
# 이 값과 무관하다 — 여기는 무한 재질의를 막는 운영 정책이다. 최소 1
SCOUT_MAX_SEARCH_REJECTIONS=3

# ── 동시성 ──────────────────────────────────────────────────
# doctor가 이 값만큼 병렬 호출해 동시 쿼터를 확인한다
SCOUT_LLM_CONCURRENCY=4
# MCP 서버의 레이트리미터와 이중 방어다
SCOUT_MCP_CONCURRENCY=8

# ── 판정·점수 ───────────────────────────────────────────────

# grounding 위반 시 재판정 횟수. 0이어도 **검출은 남는다** — 0~3
SCOUT_MAX_REGROUND=1

# 후보당 dossier에 넣을 웹 사실 상한. 그대로 judge 프롬프트 크기가 된다. 최소 1
SCOUT_MAX_WEB_FACTS=6

# 에이전트 기록을 접을 때 툴 응답 하나를 자르는 길이. 토큰과 직결된다. 최소 200
SCOUT_TOOL_PAYLOAD_CHARS=1200

# 결정 지점이 성립하는 최소 보기 수. **2 미만은 받지 않는다** — 1이면 "무엇을 고를
# 것인가"에 답이 하나인 지점이 조사로 가고, search가 억지 후보를 만들어 질문에
# 답하지 않는 후보가 1위로 올라온다 (실측). 3·4로 올려 조이는 것은 된다
SCOUT_MIN_ALTERNATIVES=2

# 1위와 2위의 overall 차이가 이만큼이면 decisive, 아니면 화면에 "근접" 배지가 붙는다.
# overall이 1~5라 상한이 있다. 1~4
SCOUT_DECISIVE_GAP=2

# ── 리포트 표시 ─────────────────────────────────────────────

# 제목 상한. 넘으면 원문 설명으로 물러난다. 프롬프트가 요구하는 40자보다 넉넉해야
# 한다 — 40 이하로 내리면 프롬프트를 지킨 제목까지 폴백으로 떨어진다. 최소 40
SCOUT_REPORT_TITLE_CHARS=60
# 접힌 블록의 요약 한 줄 길이. 전문은 바로 아래 접혀 있다. 최소 30
SCOUT_REPORT_SUMMARY_CHARS=90
# "가장 큰 위험"에 싣는 개수. 0이면 섹션이 사라지므로 최소 1
SCOUT_REPORT_RISKS=3

# ── 산출물 ──────────────────────────────────────────────────
SCOUT_RUNS_DIR=runs

# ★ 개발용 LLM 응답 캐시. 기본 off로 둔다 — 이 도구의 값어치는 사실의 신선도이고,
# 켜진 채 실전이 돌면 어제의 판정이 오늘의 추천으로 나온다. 캐시 키가 프롬프트
# 문자열이라 프롬프트를 고치면 그 단계만 자동으로 미스가 된다.
# ★ 토큰·타임아웃을 실측할 때는 끈다 — 적중한 호출은 Bedrock에 나가지 않는다
# SCOUT_LLM_CACHE=1
# SCOUT_LLM_CACHE_PATH=runs/llm-cache.sqlite

# ─────────────────────────────────────────────────────────────
# MCP 서버(scout-net-mcp) — 앱은 읽지 않고 그대로 전달만 한다
#
# ★ 이 블록의 변수는 mcp_client.SERVER_ENV_KEYS 화이트리스트를 통과해야 자식
#   프로세스에 도달한다. 새 설정을 만들 때 SCOUT_NET_ 접두사를 쓰거나 그 목록에
#   추가한다 — 빠뜨리면 .env에 써도 조용히 기본값이 쓰인다.
#   test_egress 가 두 목록의 일치를 검사한다
# ─────────────────────────────────────────────────────────────

# 없으면 60req/h. 프로토타입 규모(후보 8~10개)면 1회는 되지만 반복하면 소진된다
GITHUB_TOKEN=

# allowlist 밖 도메인은 거부되고 감사 로그에 남는다.
# www.google.com이 ddgs가 backend="google"로 고정했을 때 실제로 때리는
# 호스트다 — 품질 비교로 고른 검색엔진이다, duckduckgo가 아니다
# (providers/search.py 참고)
SCOUT_EGRESS_ALLOWLIST=registry.npmjs.org,api.npmjs.org,pypi.org,api.github.com,api.osv.dev,www.google.com

# HTTP 응답 캐시. 여러 실행이 공유해 egress를 줄인다 — LLM 캐시와는 다른 층이다
SCOUT_CACHE_DIR=.cache/scout-net
SCOUT_CACHE_TTL_HOURS=24

# 호스트별 토큰버킷. 버스트 허용량도 이 값이다(1초분)
SCOUT_RATE_LIMIT_RPS=5

# provider가 인터넷을 기다리는 상한(초). 10초는 짧다는 것이 이미 관측됐다 —
# 웹검색 승인 프롬프트가 떠 있는 동안 다른 결정 지점의 요청이 이 값에서 죽는다.
# 재시도는 없다. 실패는 gaps에 기록하고 계속한다(불변식 11)
SCOUT_NET_HTTP_TIMEOUT_SECONDS=10.0

# npm 검색이 받아올 후보 목록 폭. 뒤에서 SCOUT_MAX_CANDIDATES가 자른다. 1~250
SCOUT_NET_NPM_SEARCH_SIZE=10

# 교체 지점 — 사내 검색 API가 생기면 이 값만 바꾼다
SCOUT_SEARCH_PROVIDER=ddg
