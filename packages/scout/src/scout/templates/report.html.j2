<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ title }} — project-scout 리포트</title>
<style>
  :root {
    --bg: #f7f7f5;
    --panel: #ffffff;
    --text: #1c1c1a;
    --muted: #6b6b64;
    --border: #e1e0da;
    --accent: #3a6b52;
    --accent-soft: #e3ede7;
    --warn: #8a4a1f;
    --warn-soft: #f6e6d8;
    --bad: #7a2b2b;
    --bad-soft: #f3e0df;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #17181a;
      --panel: #212226;
      --text: #e9e8e3;
      --muted: #9a9a92;
      --border: #34353a;
      --accent: #7fbf9d;
      --accent-soft: #223027;
      --warn: #d8a15c;
      --warn-soft: #33291b;
      --bad: #d98b8b;
      --bad-soft: #362323;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2rem 1rem 4rem;
    background: var(--bg);
    color: var(--text);
    /* 한글 폰트가 Segoe UI 앞이어야 한다. 웹폰트는 못 쓴다 (CDN 0) */
    font-family: -apple-system, "Noto Sans KR", "Malgun Gothic", "Segoe UI", sans-serif;
    line-height: 1.7;
    /* 한글은 어절 단위로 끊는다. anywhere는 끊을 곳이 없는 긴 URL·패키지명용 */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  main { max-width: 880px; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin: 0 0 0.4rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.8rem; }
  h3 { font-size: 1rem; margin: 1.2rem 0 0.4rem; }
  /* 브라우저 기본 margin:1em 0 을 덮는다 */
  p { margin: 0 0 0.75rem; }
  p:last-child { margin-bottom: 0; }
  /* 제목 아래 제약 한 줄 */
  .meta { margin: 0 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  section {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .banner {
    background: var(--warn-soft);
    color: var(--warn);
    border-radius: 8px;
    padding: 0.6rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .empty { color: var(--muted); font-style: italic; }
  /* 최상단 권장 설계 — 테두리로 분리한다 */
  .final-design { border: 2px solid var(--accent); border-radius: 8px; padding: 0 1.2rem 1rem; }
  .final-design > h2 { margin-top: 1rem; }
  .lead { font-size: 1.08rem; line-height: 1.65; }
  /* shape·data_flow는 여러 줄이다 — pre-wrap 없이는 한 줄로 뭉친다 */
  pre.prose {
    white-space: pre-wrap; word-break: break-word; margin: 0;
    font-family: inherit; font-size: 0.95rem; line-height: 1.6;
  }
  /* fixed 없이는 긴 fact.value가 열을 밀어 표가 main 폭을 넘는다 */
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { text-align: left; padding: 0.4rem 0.5rem; vertical-align: top; }
  td { overflow-wrap: anywhere; }
  thead th { color: var(--muted); font-weight: 500; font-size: 0.85rem; border-bottom: 1px solid var(--border); }
  tbody tr + tr td { border-top: 1px solid var(--border); }
  .score-row { display: flex; align-items: center; gap: 0.5rem; margin: 0.2rem 0; }
  .score-label { min-width: 4.5rem; font-size: 0.85rem; color: var(--muted); }
  .bar-track {
    flex: 1 1 auto;
    max-width: 220px;
    height: 0.6rem;
    background: var(--border);
    border-radius: 4px;
    overflow: hidden;
  }
  .bar-fill { height: 100%; background: var(--accent); border-radius: 4px; }
  .score-num { min-width: 1.2rem; font-weight: 600; }
  .score-reason { color: var(--muted); font-size: 0.85rem; margin: 0.1rem 0 0.6rem; }
  .badge {
    display: inline-block;
    font-size: 0.72rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    white-space: nowrap;
  }
  .badge-computed { color: var(--accent); border-color: var(--accent); }
  .badge-judged { color: var(--text); border-color: var(--text); }
  .badge-unavailable { color: var(--muted); }
  .badge-close { color: var(--warn); border-color: var(--warn); }
  .badge-violation, .badge-low { color: var(--bad); border-color: var(--bad); }
  .candidate-block { padding: 0.7rem 0; }
  .candidate-block + .candidate-block { border-top: 1px dashed var(--border); }
  .candidate-block.rejected { opacity: 0.7; }
  .candidate-name { font-weight: 600; }
  .candidate-name.rejected { text-decoration: line-through; }
  .quote { margin: 0.2rem 0 0.4rem; }
  .quote::before { content: "↳ "; color: var(--muted); }
  ul.plain { margin: 0.2rem 0; padding-left: 1.2rem; }
  details { margin-top: 0.5rem; }
  summary { cursor: pointer; font-weight: 600; }
  /* fact_id는 끊기면 못 읽는다. 열 너비는 table-layout:fixed가 잡는다 */
  .fact-row td:first-child { font-family: ui-monospace, monospace; font-size: 0.85rem; white-space: nowrap; }
  /* 같은 문장을 두 번 읽지 않게 접는다 (5-report.md) */
  .folded > summary { font-weight: 400; color: var(--muted); font-size: 0.9rem; }
  .folded > summary::marker { color: var(--muted); }
  .cited { color: var(--accent); }
  footer { color: var(--muted); font-size: 0.8rem; text-align: center; margin-top: 2rem; }

  /* ── 목차 · 그룹 · 팝오버 (JS 0줄 · 웹폰트 0) ────────────────────── */

  /* 좁은 화면 — 본문 위 정적 블록 */
  nav.toc {
    max-width: 880px;
    margin: 0 auto 2rem;
    padding: 0.6rem 1rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 0.85rem;
  }
  nav.toc ol {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.15rem 0.7rem; align-items: baseline;
  }
  .toc-group { color: var(--muted); font-weight: 600; font-size: 0.78rem; }
  nav.toc a {
    color: var(--muted); text-decoration: none;
    display: block; padding: 0.05rem 0.35rem; border-radius: 5px;
  }
  nav.toc a:hover, nav.toc a:focus { color: var(--text); background: var(--accent-soft); }

  /* 넓은 화면 — 왼쪽 빈 공간에 고정. 880px 본문 + 목차가 들어가는 폭부터 */
  @media (min-width: 1340px) {
    nav.toc {
      position: fixed; top: 2rem;
      left: max(1rem, calc(50% - 440px - 17rem));
      width: 15rem; max-height: calc(100vh - 4rem); overflow-y: auto;
      margin: 0; padding: 0; background: transparent; border: 0;
    }
    nav.toc ol { display: block; }
    .toc-group { margin-top: 0.7rem; }
    nav.toc a { border-left: 2px solid transparent; border-radius: 0 5px 5px 0; }
    nav.toc a:hover, nav.toc a:focus { border-left-color: var(--accent); }
  }

  /* 앵커로 이동한 곳을 표시한다 — 어디로 갔는지 안 보이면 목차가 반쪽이다 */
  [id] { scroll-margin-top: 1.5rem; }
  section:target, details:target { outline: 2px solid var(--accent); outline-offset: 4px; }

  /* 그룹 — 무게 차이가 곧 내용 구분이다 */
  .group { margin: 0 0 3rem; }
  .group-head {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.7rem;
    margin: 0 0 1.25rem; padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }
  .group-label { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.01em; }
  .group-note { color: var(--muted); font-size: 0.85rem; margin: 0; }
  /* 최상위 details도 섹션과 같은 판으로 — 그룹 안에서 무게가 들쭉날쭉하지 않게 */
  .group > details {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 10px; padding: 1rem 1.5rem; margin-bottom: 1.25rem;
  }
  .group-conclusion .group-head { border-bottom-color: var(--accent); }
  .group-conclusion .group-label { color: var(--accent); }
  .group-evidence .group-label { color: var(--muted); }
  .group-evidence > section, .group-evidence > details {
    background: transparent; border-style: dashed;
  }

  /* 펼칠 수 있다는 게 보여야 한다 */
  summary:hover { color: var(--accent); }
  details[open] > summary { margin-bottom: 0.4rem; }
  .folded { border: 1px dashed var(--border); border-radius: 8px; padding: 0.3rem 0.6rem; }
  .folded[open] { background: var(--bg); }

  /* 보조 설명 — 호버와 포커스 둘 다 받는다. 터치 기기에는 호버가 없다 */
  .hint { position: relative; cursor: help; border-bottom: 1px dotted currentColor; }
  .hint > .hint-body {
    position: absolute; left: 0; bottom: calc(100% + 0.4rem); z-index: 20;
    width: max-content; max-width: 17rem;
    padding: 0.5rem 0.7rem;
    background: var(--panel); color: var(--text);
    border: 1px solid var(--border); border-radius: 8px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
    font-size: 0.8rem; font-weight: 400; line-height: 1.55;
    text-align: left; white-space: normal; word-break: keep-all;
    visibility: hidden; opacity: 0; transition: opacity 0.12s ease;
  }
  .hint:hover > .hint-body, .hint:focus > .hint-body, .hint:focus-within > .hint-body {
    visibility: visible; opacity: 1;
  }
  /* 좁은 화면에서는 화면 하단에 붙인다 — absolute면 숨겨진 상태로도 폭을 차지해
     페이지가 가로로 스크롤된다(420px 실측 +179px). fixed는 scrollWidth에 기여하지 않는다 */
  @media (max-width: 640px) {
    .hint > .hint-body {
      position: fixed; inset: auto 1rem 1rem; width: auto; max-width: none; z-index: 60;
    }
  }

  /* 이 문서의 목적은 공유다 — 인쇄에서 접힌 내용이 사라지면 안 된다 */
  @media print {
    nav.toc, .hint-body { display: none; }
    details:not([open]) > *:not(summary) { display: block; }
    body { padding: 0; background: #fff; color: #000; }
    .group > section, .group > details { break-inside: avoid; }
  }
</style>
</head>
<body>
{# 목차 — CSS만으로 넓은 화면에서는 왼쪽 고정, 좁으면 본문 위로 내려간다 #}
<nav class="toc">
  <ol>
    <li class="toc-group">결론</li>
    <li><a href="#recommended">권장 설계</a></li>
    <li><a href="#picked">선택한 기술</a></li>
    <li class="toc-group">전제</li>
    <li><a href="#closed">이미 정해진 것</a></li>
    <li><a href="#deferred">지금 만들지 않아도 되는 것</a></li>
    <li><a href="#skipped">이번에 다루지 않은 것</a></li>
    <li><a href="#baseline">기본 설계 (조사 전)</a></li>
    <li class="toc-group">근거</li>
    <li><a href="#compared">결정 지점별 비교</a></li>
    <li><a href="#rejected">탈락 사유</a></li>
    <li><a href="#facts">수집한 사실</a></li>
    <li><a href="#commands">다음 명령어</a></li>
  </ol>
</nav>
<main>

{# 보조 설명 — 짧은 것만 팝오버로 준다. 긴 산문은 details로 접는다 #}
{% macro hint(text, body, cls="") %}
<span class="hint badge {{ cls }}" tabindex="0">{{ text }}<span class="hint-body">{{ body }}</span></span>
{%- endmacro %}

{% macro score_bar(entry, label, reason=true) %}
  <div class="score-row">
    {% if label %}<span class="score-label">{{ label }}</span>{% endif %}
    {% if entry and entry.score is not none %}
      <div class="bar-track"><div class="bar-fill" style="width: {{ entry.score * 20 }}%"></div></div>
      <span class="score-num">{{ entry.score }}</span>
      {% if entry.source == "computed" %}
      {{ hint("계산", "rubric.py의 공식이 사실에서 계산한 값이다. judge가 낡은 사실을 무시해도 이 계산이 잡는다.", "badge-computed") }}
      {% else %}
      {{ hint("판정", "judge가 dossier를 읽고 매긴 값이다. maturity·risk의 평균이 아니다.", "badge-judged") }}
      {% endif %}
    {% else %}
      {{ hint("근거 없음", "계산할 사실이 없다. 낮은 게 아니라 없는 것이다 — 0으로 대접하면 실제보다 불리해 보인다.", "badge-unavailable") }}
    {% endif %}
  </div>
  {% if reason and entry and entry.reason %}<div class="score-reason">{{ entry.reason | sentences }}</div>{% endif %}
{% endmacro %}

{# 제목 + 제약 한 줄 (5-report.md). refined_brief 전문은 "결정 요약"에 있다 #}
<h1>{{ title }}</h1>
{% if constraints %}
<p class="meta">
  {% for c in constraints %}<span class="badge">{{ c }}</span>{% endfor %}
</p>
{% endif %}

{% if incomplete %}
<div class="banner">⚠ 파이프라인이 끝까지 실행되지 않았습니다 — 아래는 지금까지 저장된 결과입니다.</div>
{% endif %}

<div class="group group-conclusion">
  <div class="group-head">
    <span class="group-label">결론</span>
    <p class="group-note">이것만 읽어도 된다.</p>
  </div>

{# 최상단 — 가장 먼저 읽어야 하는 것. evaluate가 확정한 v2다 #}
<section id="recommended" class="final-design">
  <h2>★ 권장 설계</h2>
  {% if final_design %}
  {# sentences가 <p>를 만든다 — 또 감싸면 중첩 <p>로 무효 HTML이 된다 #}
  <div class="lead">{{ final_design.summary | sentences }}</div>

  <h3>구조</h3>
  <pre class="prose">{{ final_design.shape }}</pre>
  <h3>데이터 흐름</h3>
  <pre class="prose">{{ final_design.data_flow }}</pre>

  <h3>조사로 바뀐 것</h3>
  {% if final_design.changes_from_design %}
  <ul class="plain">{% for c in final_design.changes_from_design %}<li>{{ c }}</li>{% endfor %}</ul>
  {% else %}
  {# 빈 것도 정보다 (불변식 12) #}
  <p class="empty">조사 결과가 기본틀을 바꾸지 않았습니다 — 설계가 조사를 견뎠습니다.</p>
  {% endif %}

  <h3>왜 이 조합인가</h3>
  {{ final_design.stack_rationale | sentences }}

  <h3>구축 순서</h3>
  {% if final_design.build_order %}
  <ol class="plain">{% for s in final_design.build_order %}<li>{{ s }}</li>{% endfor %}</ol>
  {% else %}
  <p class="empty">해당 없음 — 구축 순서가 산출되지 않았습니다.</p>
  {% endif %}

  <h3>연동 지점</h3>
  {% if final_design.integration_notes %}
  <ul class="plain">{% for n in final_design.integration_notes %}<li>{{ n }}</li>{% endfor %}</ul>
  {% else %}
  <p class="empty">해당 없음 — 조합에서 특별히 이을 지점이 지적되지 않았습니다.</p>
  {% endif %}

  <h3>조합 위험</h3>
  {% if final_design.combination_risks %}
  <ul class="plain">{% for r in final_design.combination_risks %}<li>{{ r }}</li>{% endfor %}</ul>
  {% else %}
  <p class="empty">해당 없음 — 조합해서 생기는 위험이 지적되지 않았습니다. 개별 후보의 단점은 "결정 지점별 비교"에 있습니다.</p>
  {% endif %}

  <h3>미해결 항목</h3>
  {% if final_design.unresolved %}
  <ul class="plain">{% for u in final_design.unresolved %}<li>{{ u }}</li>{% endfor %}</ul>
  {% else %}
  <p class="empty">해당 없음 — 남은 미해결 항목이 없습니다.</p>
  {% endif %}
  {% else %}
  {# 행이 없어도 섹션을 지우지 않는다 (불변식 12) #}
  <p class="empty">설계 확정이 실패했거나 아직 실행되지 않았습니다 — 아래 "그 외 미확인"에서 이유를 확인하세요.</p>
  {% endif %}
</section>

<section id="picked">
  <h2>선택한 기술</h2>
  {% if no_winner %}
  <div class="banner">⚠ 통과 후보가 없는 결정 지점 {{ no_winner|length }}개: {{ no_winner|join(', ') }} — 아래 "결정 지점별 비교"에서 탈락 사유를 확인하세요.</div>
  {% endif %}
  {% if stack %}
  {# 막대는 남기고 산문은 접는다 — 비교가 한눈에 보이는 것이 이 표의 목적이다 #}
  <table>
    <thead><tr><th>결정 지점</th><th>고른 것</th><th>종합</th><th>이유</th></tr></thead>
    <tbody>
    {% for row in stack %}
      <tr>
        <td>{{ row.component }}</td>
        <td>{{ row.candidate }}{% if row.margin == "close" %} {{ hint("근접", "1위와 2위의 종합 점수 차이가 작다. 2위도 합리적 선택지라는 뜻이다.", "badge-close") }}{% endif %}</td>
        <td style="min-width:150px">{{ score_bar(row.overall, "", reason=false) }}</td>
        <td>
          <details class="folded">
            <summary>{{ row.winner_reason | summary_line }}</summary>
            {{ row.winner_reason | sentences }}
            {% if row.overall and row.overall.reason %}
            <p class="score-reason">점수 근거</p>
            {{ row.overall.reason | sentences }}
            {% endif %}
          </details>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">해당 없음 — 통과한 결정 지점이 아직 없습니다.</p>
  {% endif %}

  <h3>가장 큰 위험</h3>
  {% if risks %}
  <ul class="plain">{% for r in risks %}<li>{{ r }}</li>{% endfor %}</ul>
  {% else %}
  <p class="empty">해당 없음 — 고른 후보에 남은 단점·유의사항이 없습니다.</p>
  {% endif %}

  <h3>명시된 가정</h3>
  {% if assumptions %}
  <ul class="plain">{% for a in assumptions %}<li>{{ a }}</li>{% endfor %}</ul>
  {% else %}
  <p class="empty">해당 없음 — 사용자가 모든 질문에 응답해 기본값을 쓰지 않았습니다.</p>
  {% endif %}

  {# 구체화된 명세 — 정본이 이 자리로 규정한다 (5-report.md) #}
  <h3>구체화된 명세</h3>
  {% if refined_brief %}
  {{ refined_brief | sentences }}
  {% else %}
  <p class="empty">해당 없음 — interview가 명세를 만들지 못했습니다.</p>
  {% endif %}
</section>
</div>


<div class="group group-premise">
  <div class="group-head">
    <span class="group-label">전제</span>
    <p class="group-note">이 결론이 무엇을 깔고 있나.</p>
  </div>

{# 권장 설계가 깔고 있는 전제. "필요 없어서"와 다른 섹션이다 (불변식 17) #}
<section id="closed">
  <h2>🔒 이미 정해진 것</h2>
  {% if closed %}
  <ul class="plain">
    {% for c in closed %}
    <li><strong>{{ c.name }}</strong> ({{ c.necessity }}) — {{ c.no_comparison_reason or c.role_in_design }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty">해당 없음 — 모든 결정 지점을 비교해서 골랐습니다. (설명에 이미 정해진 전제가 없었거나, 설계가 전제를 못 찾은 것입니다.)</p>
  {% endif %}
</section>

<section id="deferred">
  <h2>💡 지금 만들지 않아도 되는 것</h2>
  {% if deferred %}
  <ul class="plain">
    {% for c in deferred %}
    <li><strong>{{ c.name }}</strong> ({{ c.necessity }}) — {{ c.necessity_reason }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty">해당 없음 — 이번 설명에서는 뒤로 미루거나 불필요하다고 판단된 요소가 없습니다.</p>
  {% endif %}
</section>

<section id="skipped">
  <h2>이번에 다루지 않은 것</h2>
  {% if skipped %}
  <ul class="plain">
    {% for c in skipped %}
    <li><strong>{{ c.name }}</strong> ({{ c.necessity }}, priority {{ c.priority }}) — {{ c.role_in_design }}</li>
    {% endfor %}
  </ul>
  <p class="score-reason">더 보려면 <code>--max-components {{ skipped_reopen_count }}</code>로 다시 돌리세요.</p>
  {% else %}
  <p class="empty">해당 없음 — 통과 대상 요소를 전부 다뤘습니다.</p>
  {% endif %}
</section>

{# v1 대조 — 같은 이름의 필드를 나란히 놓기만 한다. 무엇이 바뀌었는지는
   위의 changes_from_design이 말한다 #}
<details id="baseline">
  <summary>기본 설계 (조사 전) — v1 대조</summary>
  {% if architecture %}
  {{ architecture.summary | sentences }}
  <table>
    <thead><tr><th></th><th>기본 설계</th><th>권장 설계</th></tr></thead>
    <tbody>
      <tr>
        <td><strong>구조</strong></td>
        <td><pre class="prose">{{ architecture.shape }}</pre></td>
        <td><pre class="prose">{{ final_design.shape if final_design else "—" }}</pre></td>
      </tr>
      <tr>
        <td><strong>데이터 흐름</strong></td>
        <td><pre class="prose">{{ architecture.data_flow }}</pre></td>
        <td><pre class="prose">{{ final_design.data_flow if final_design else "—" }}</pre></td>
      </tr>
    </tbody>
  </table>
  <h3>설계 단계에서 답하지 못한 질문</h3>
  {% if architecture.open_questions %}
  <ul class="plain">{% for q in architecture.open_questions %}<li>{{ q }}</li>{% endfor %}</ul>
  {% else %}
  <p class="empty">해당 없음 — 설계 단계에서 미해결로 남긴 질문이 없습니다.</p>
  {% endif %}
  {% else %}
  <p class="empty">해당 없음 — 설계 본문이 저장되지 않았습니다.</p>
  {% endif %}
</details>
</div>


<div class="group group-evidence">
  <div class="group-head">
    <span class="group-label">근거</span>
    <p class="group-note">결론을 못 믿겠으면 여기를 본다.</p>
  </div>

<section id="compared">
  <h2>결정 지점별 비교</h2>
  {% if elements %}
  {% for el in elements %}
  <h3>{{ el.component.name }}</h3>
  {% for c in el.candidates %}
  <div class="candidate-block{% if c.rank is none %} rejected{% endif %}">
    <span class="candidate-name{% if c.rank is none %} rejected{% endif %}">
      {{ "✔" if c.rank == 1 else ("✘" if c.rank is none else "·") }} {{ c.name }}
    </span>
    {% if c.kind %}<span class="badge">{{ c.kind }}</span>{% endif %}
    {% if c.grounding_violations %}{{ hint("근거 위반 " ~ c.grounding_violations ~ "건", "judge가 dossier에 없는 사실을 인용했다. 코드가 SQL로 대조해 걷어낸 횟수다.", "badge-violation") }}{% endif %}

    {# 점수만 보이면 무엇을 고른 건지 알 수 없다 #}
    {% if c.what_it_is %}<p class="score-reason">{{ c.what_it_is }}</p>{% endif %}

    {% if c.rank is none %}
      {# 전문은 아래 "탈락 사유"에 있다 #}
      <details class="folded">
        <summary>탈락 — {{ c.rejected_reason | summary_line }}</summary>
        {{ c.rejected_reason | sentences }}
      </details>
    {% else %}
      {{ score_bar(c.overall, "종합") }}
      {% if c.rank == 1 %}
        {# 전문은 위 "선택한 기술" 표에 있다 #}
        <details class="folded">
          <summary><strong>1위</strong> {{ c.winner_reason | summary_line }}</summary>
          {{ c.winner_reason | sentences }}
        </details>
      {% elif c.runner_up_note %}
        <div class="quote">{{ c.runner_up_note | sentences }}</div>
      {% endif %}
      {% if c.verdict and c.verdict.solves_reason %}
      <details class="folded">
        <summary>해결함 — {{ c.verdict.solves_reason | summary_line }}</summary>
        {{ c.verdict.solves_reason | sentences }}
      </details>
      {% endif %}
      {% if c.verdict and c.verdict.pros %}
      <ul class="plain">{% for p in c.verdict.pros %}<li>{{ p }}</li>{% endfor %}</ul>
      {% endif %}
      {{ score_bar(c.maturity, "성숙도") }}
      {{ score_bar(c.risk, "위험") }}
      {% if c.dossier_gaps %}
      <p class="score-reason">미확인:</p>
      <ul class="plain">{% for g in c.dossier_gaps %}<li>{{ g }}</li>{% endfor %}</ul>
      {% endif %}
    {% endif %}
  </div>
  {% endfor %}
  {% endfor %}
  {% else %}
  <p class="empty">해당 없음 — 아직 평가된 결정 지점이 없습니다.</p>
  {% endif %}
</section>

<details id="rejected">
  <summary>탈락 사유</summary>
  {% if rejections %}
  <table>
    <thead><tr><th>결정 지점</th><th>후보</th><th>탈락 사유</th></tr></thead>
    <tbody>
    {% for r in rejections %}
      <tr><td>{{ r.component }}</td><td>{{ r.candidate }}</td><td>{{ r.reason | sentences }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">해당 없음 — 탈락한 후보가 없습니다.</p>
  {% endif %}
</details>

<details id="facts">
  <summary>수집한 사실</summary>
  {% if facts_by_candidate %}
  {% for group in facts_by_candidate %}
  <h3>
    {{ group.candidate }} ({{ group.component }}{% if group.kind %} · {{ group.kind }}{% endif %})
    {% if group.verdict and group.verdict.confidence == "low" %}{{ hint("신뢰도 낮음", "judge가 스스로 낮다고 적었거나, 인용이 dossier 밖을 가리켜 코드가 강등했다.", "badge-low") }}{% endif %}
    {% if group.grounding_violations %}{{ hint("근거 위반 " ~ group.grounding_violations ~ "건", "judge가 dossier에 없는 사실을 인용했다. 코드가 SQL로 대조해 걷어낸 횟수다.", "badge-violation") }}{% endif %}
  </h3>
  {% if group.facts %}
  <table>
    <thead><tr><th>{{ hint("사실 id", "`<출처>.<항목>` 규칙이다 (npm.last_release · gh.archived · web.3). judge는 이 id로만 인용할 수 있다.") }}</th><th>항목</th><th>값</th><th>출처</th><th>조회일</th></tr></thead>
    <tbody>
    {% for row in group.facts %}
      <tr class="fact-row">
        <td class="{{ 'cited' if row.cited else '' }}">{{ row.fact.id }}{% if row.cited %} ✓{% endif %}</td>
        <td>{{ row.fact.label }}</td>
        <td>{{ row.fact.value }}</td>
        <td>{% if row.fact.url %}<a href="{{ row.fact.url }}">열기</a>{% endif %}</td>
        <td>{{ row.fact.retrieved_at }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">해당 없음 — 조회된 사실이 없습니다.</p>
  {% endif %}
  {% if group.dossier_gaps %}
  <p class="score-reason">미확인:</p>
  <ul class="plain">{% for g in group.dossier_gaps %}<li>{{ g }}</li>{% endfor %}</ul>
  {% endif %}
  {% endfor %}
  {% else %}
  <p class="empty">해당 없음 — 저장된 사실이 없습니다.</p>
  {% endif %}

  {% if other_gaps %}
  <h3>그 외 미확인</h3>
  <ul class="plain">
    {% for g in other_gaps %}<li><strong>{{ g.candidate }}</strong>: {{ g.note }}</li>{% endfor %}
  </ul>
  {% endif %}
</details>

<details id="commands">
  <summary>다음 명령어</summary>
  <p>지금까지 결과를 다시 보려면:</p>
  <ul class="plain">
    <li><code>scout show {{ slug }} design</code> — 결정 지점 전체(걸러진 것 포함)</li>
    <li><code>scout show {{ slug }} search</code> — 후보별 사실 원본(dossier)</li>
    <li><code>scout show {{ slug }} verify</code> — 판정 전문</li>
    <li><code>scout show {{ slug }} evaluate</code> — 점수·순위 전문</li>
  </ul>
  {% if stack %}
  <p>확정된 후보:</p>
  <ul class="plain">
    {% for row in stack %}<li>{{ row.component }} → {{ row.candidate }}</li>{% endfor %}
  </ul>
  {% endif %}
</details>
</div>


<footer>project-scout · {{ slug }}</footer>
</main>
</body>
</html>
